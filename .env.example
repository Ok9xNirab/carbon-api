# Copy to .env for local development. Every key is optional; the values below are the defaults.
# Never commit .env — it is git-ignored.

# local | prod
CARBON_ENV=local

# Comma-separated list of allowed CORS origins.
CARBON_CORS_ORIGINS=http://localhost:3000

# Web search provider for source discovery: none | brave | google
CARBON_SEARCH_PROVIDER=none
# Required when CARBON_SEARCH_PROVIDER is not "none" in prod.
CARBON_SEARCH_API_KEY=

# AWS resources
CARBON_DYNAMODB_TABLE=carbon-local
CARBON_S3_BUCKET=carbon-artifacts-local
# Required in prod.
CARBON_SQS_QUEUE_URL=

# Limits
CARBON_MAX_WORDS_PER_SIDE=5000
CARBON_MAX_SOURCES=10
CARBON_MAX_QUERIES_PER_CHECK=20
CARBON_DAILY_QUERY_CAP=1000

# Similarity thresholds (0.0–1.0)
CARBON_CONTAINMENT_THRESHOLD=0.05
CARBON_PARAPHRASE_THRESHOLD=0.80
